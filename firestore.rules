rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function hasRole(role) { return signedIn() && request.auth.token.role == role; }
    match /vehicles/{vehicleId} {
      // Both public projection and role-filtered internal reads use server APIs.
      allow read: if false;
      // Mobilox imports and authorized internal/deal APIs use Admin transactions.
      allow create, update, delete: if false;
    }
    match /leads/{leadId} {
      allow read, write: if false;
    }
    match /leadActivities/{id} { allow read, write: if false; }
    match /appointments/{id} { allow read, write: if false; }
    match /quotes/{id} { allow read, write: if false; }
    match /tradeIns/{id} { allow read, write: if false; }
    match /customers/{customerId} { allow read, write: if false; }
    match /tasks/{taskId} { allow read, write: if false; }
    // Commercial Core writes go through server-authorized repositories only.
    match /deals/{dealId} { allow read, write: if false; }
    match /dealSnapshots/{snapshotId} { allow read, write: if false; }
    match /deliveryTasks/{taskId} { allow read, write: if false; }
    match /payments/{paymentId} { allow read, write: if false; }
    match /dealDocuments/{documentId} { allow read, write: if false; }
    match /financeApplications/{applicationId} { allow read, write: if false; }
    match /audit_logs/{logId} { allow read: if hasRole('owner') || hasRole('admin'); allow write: if false; }

    // Social Video is deliberately server-only. Public access goes through the
    // allow-listed Next.js API; VVOS mutations use Firebase Admin after API auth.
    match /socialVideos/{videoId} { allow read, write: if false; }
    // Internal certificates are accessed exclusively through authorized VVOS APIs.
    match /sohCertificates/{reportId} { allow read, write: if false; }
    match /vehicleSohReports/{vehicleId} { allow read, write: if false; }
    match /stockAlertSubscriptions/{recordId} { allow read, write: if false; }
    match /stockAlertTokens/{recordId} { allow read, write: if false; }
    match /stockAlertCandidates/{recordId} { allow read, write: if false; }
    match /stockAlertJobs/{recordId} { allow read, write: if false; }
    match /stockAlertAttempts/{recordId} { allow read, write: if false; }
    match /stockAlertDeliveries/{recordId} { allow read, write: if false; }
    match /stockAlertAudit/{recordId} { allow read, write: if false; }
    match /stockAlertRateLimits/{recordId} { allow read, write: if false; }
    match /stockAlertControl/{recordId} { allow read, write: if false; }
    match /stockAlertWebhooks/{recordId} { allow read, write: if false; }
  }
}
